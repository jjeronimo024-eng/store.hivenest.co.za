# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hivenest_main
DB_USER=hivenest_hostingsetup
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
DB_CHARSET=utf8mb4

# JWT Configuration
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Application Settings
APP_NAME=HiveNest Matrix
APP_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=https://hivenest.co.za,https://cp.hivenest.co.za,https://crm.hivenest.co.za
COOKIE_DOMAIN=.hivenest.co.za
COOKIE_SECURE=true
CUSTOMER_SESSION_IDLE_MINUTES=120
DEBUG=true

# Upload malware scanning.
# Example Linux path: /usr/bin/clamscan
# Keep UPLOAD_SCAN_REQUIRED=false until ClamAV is installed and tested. Set it
# to true before production so files remain quarantined when scanning fails.
CLAMAV_BINARY=
UPLOAD_SCAN_REQUIRED=false

# One-time admin recovery (keep disabled except during a deliberate recovery).
# Generate a new random token of at least 32 characters for every recovery.
ADMIN_RESET_ENABLED=false
ADMIN_RESET_TOKEN=
# Optional ISO-8601 expiry, for example: 2026-07-28T18:00:00+02:00
ADMIN_RESET_EXPIRES_AT=
# Random secret used to hash rate-limit client identifiers at rest.
RATE_LIMIT_SECRET=YOUR_RANDOM_RATE_LIMIT_SECRET_HERE

# MyOrderBox Reseller API Configuration
MYORDERBOX_RESELLER_ID=YOUR_RESELLER_ID
MYORDERBOX_API_KEY=YOUR_API_KEY
MYORDERBOX_BASE_URL=https://httpapi.com
MYORDERBOX_TEST_URL=https://test.httpapi.com
MYORDERBOX_DOMAIN_CHECK_URL=https://domaincheck.httpapi.com
# Use test until all provisioning gates pass; change to production only at go-live.
MYORDERBOX_ENV=test
# Optional: defaults to MYORDERBOX_RESELLER_ID.
MYORDERBOX_BALANCE_RESELLER_ID=
MYORDERBOX_LOW_BALANCE_THRESHOLD=100.00
MYORDERBOX_BALANCE_CACHE_SECONDS=300
PROVISIONING_UNRESOLVED_ALERT_MINUTES=60

# PayPal Payment Gateway Configuration
# Mode: sandbox (for testing) or live (for production)
PAYPAL_MODE=sandbox
# Get your credentials from: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
# Durable transactional email delivery
MAIL_TRANSPORT=php_mail
MAIL_PROCESS_IMMEDIATELY=false
MAIL_WORKER_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
MAIL_FROM_ADDRESS=no-reply@hivenest.co.za
# HMAC secret used by the trusted SMTP-provider event adapter.
MAIL_EVENT_WEBHOOK_SECRET=PASTE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS_HERE
MAIL_EVENT_MAX_AGE_SECONDS=300
TWO_FACTOR_ENCRYPTION_KEY=PASTE_BASE64_32_BYTE_KEY_HERE
# Use a separate key from TWO_FACTOR_ENCRYPTION_KEY. Generate with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
SERVICE_CREDENTIAL_ENCRYPTION_KEY=PASTE_A_DIFFERENT_BASE64_32_BYTE_KEY_HERE
# HMAC secret shared only with the trusted monitoring agent/provider adapter.
MONITORING_INGEST_SECRET=PASTE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS_HERE
MONITORING_STALE_MINUTES=5
MONITORING_RETENTION_DAYS=90
MONITORING_CPU_WARNING_PERCENT=90
MONITORING_MEMORY_WARNING_PERCENT=90
MONITORING_DISK_WARNING_PERCENT=85
MONITORING_LATENCY_WARNING_MS=1000
MONITORING_ENDPOINT=https://hivenest.co.za/api/monitoring/ingest
MONITORING_NODE_KEY=web-01
MONITORING_NODE_NAME=HiveNest Web Server 01
MONITORING_PROVIDER=hivenest-signed-agent
MONITORING_LATENCY_URL=https://hivenest.co.za/
BACKUP_DIRECTORY=/secure/offsite-staging/hivenest
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql
RESTORE_TEST_DB_HOST=
RESTORE_TEST_DB_PORT=3306
RESTORE_TEST_DB_USER=
RESTORE_TEST_DB_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
